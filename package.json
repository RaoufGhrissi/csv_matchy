{
  "name": "csv-matchy-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "src/libs/matchy"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @csv-matchy/core build",
    "build:vanilla": "pnpm --filter @csv-matchy/vanilla build",
    "build:react": "pnpm --filter @csv-matchy/react build",
    "build:angular": "pnpm --filter @csv-matchy/angular build",
    "publish": "pnpm -r publish",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @csv-matchy/core test",
    "test:vanilla": "pnpm --filter @csv-matchy/vanilla test",
    "test:all": "pnpm --filter @csv-matchy/core test && pnpm --filter @csv-matchy/vanilla test"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
