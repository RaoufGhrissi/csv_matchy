{
  "name": "sheet-matchy",
  "version": "2.1.1",
  "description": "A TypeScript web component for importing Excel (.xlsx) spreadsheets, matching columns, and validating and editing cells before submission.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "demo": "vite --config demo/vite.config.ts",
    "build:demo": "tsc -p demo && vite build --config demo/vite.config.ts",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaoufGhrissi/sheet-matchy.git"
  },
  "keywords": [
    "excel",
    "xlsx",
    "spreadsheet",
    "import",
    "importer",
    "csv",
    "column-mapping",
    "data-validation",
    "validator",
    "web-component",
    "angular",
    "react",
    "vue",
    "typescript"
  ],
  "author": "Abderraouf Ghrissi & Mahdi Cheikhrouhou",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RaoufGhrissi/sheet-matchy/issues"
  },
  "homepage": "https://raoufghrissi.github.io/sheet-matchy/",
  "dependencies": {
    "@types/string-similarity": "^4.0.2",
    "date-fns": "^4.1.0",
    "read-excel-file": "^5.8.8",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.4.10"
  }
}
